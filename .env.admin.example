# Server-only credentials. Copy to .env.admin.local and never expose these values to Vite.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Optional for CI backup; use a direct or session-pooler PostgreSQL connection string.
SUPABASE_DB_URL=
REPPY_TEST_ACCOUNT_EMAILS=trainer@example.com,student@example.com
# Required only by test-accounts:delete
REPPY_CONFIRM_TEST_RESET=
# Optional; defaults to the gitignored .backups directory in the project.
REPPY_BACKUP_DIR=.backups
