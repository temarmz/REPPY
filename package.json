{
  "name": "reppy-prototype-v0",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview": "vite preview --config vite.pages.config.ts",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "npm run build:pages && playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:test": "supabase test db",
    "trainer:create": "node --env-file-if-exists=.env.admin.local scripts/create-trainer.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2"
  },
  "type": "module"
}
